# ── 사내 LLM 게이트웨이 연결 (Anthropic 호환 엔드포인트) ──────────────────────
# 이 파일을 `.env` 로 복사한 뒤 실제 값을 채우세요. `.env` 는 절대 공유/커밋하지 마세요.
#
# 사내 게이트웨이가 OpenAI 호환이면, 사내망에 Anthropic→OpenAI 변환 프록시
# (LiteLLM / claude-code-router)를 두고 그 주소를 ANTHROPIC_BASE_URL 에 적습니다.
# 자세한 절차는 ENVIRONMENT_SETUP.md 를 참조하세요.

ANTHROPIC_BASE_URL=http://INTERNAL-PROXY-HOST:PORT
ANTHROPIC_AUTH_TOKEN=replace-with-internal-token

# 모델명 — 게이트웨이/프록시가 매핑하는 실제 모델명으로 바꿀 수 있습니다.
HERMES_AGENT_MODEL={{MODEL}}

# 응답 최대 토큰(선택)
HERMES_AGENT_MAX_TOKENS=16000
